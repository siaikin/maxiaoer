{
  "name": "maxiaoer",
  "private": true,
  "version": "0.2.0",
  "description": "一键发布图文到小红书 / 微博 / 微信公众号 / X / Facebook / 哔哩哔哩模型小站的桌面工具（参考蚁小二）",
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc -p tsconfig.web.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "browser:prepare": "node scripts/prepare-browser.mjs",
    "package": "pnpm browser:prepare && electron-vite build && electron-builder",
    "plugin:build": "node scripts/build-plugin.mjs",
    "plugin:test": "node --test scripts/test-plugin.mjs"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.142",
    "@iconify/vue": "^5.0.3",
    "@nuxt/ui": "^4.11.3",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vueuse/core": "^14.4.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "@tailwindcss/oxide",
      "vue-demi"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "cloakbrowser": "0.6.0",
    "puppeteer-core": "^25.13.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  }
